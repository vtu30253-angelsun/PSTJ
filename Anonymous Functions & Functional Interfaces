import java.util.*;

class Checker implements Comparator<Player> {

    @Override
    public int compare(Player a, Player b) {

        // Score: descending
        if (a.score != b.score) {
            return Integer.compare(b.score, a.score);
        }

        // Name: ascending alphabetical order
        return a.name.compareTo(b.name);
    }
}
